{
  "expo": {
    "name": "Sankat.AI",
    "slug": "sankatai-mobile",
    "version": "1.0.0",
    "scheme": "sankatai",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Sankat.AI uses your location to include it in an emergency message that you choose to send.",
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "NSMicrophoneUsageDescription": "Sankat.AI uses the microphone only when you tap the mic button, to turn your spoken symptoms into text. Audio is not stored."
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.sankataimobile",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-document-picker",
      "expo-image-picker",
      "expo-location",
      "expo-secure-store",
      "expo-web-browser",
      [
        "@siteed/audio-studio",
        {
          "enablePhoneStateHandling": false,
          "enableNotifications": false,
          "enableBackgroundAudio": false,
          "enableDeviceDetection": false,
          "iosConfig": {
            "microphoneUsageDescription": "Sankat.AI uses the microphone only when you tap the mic button, to turn your spoken symptoms into text. Audio is not stored."
          }
        }
      ]
    ]
  }
}
