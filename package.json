{
  "name": "sankatai",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@sankatai/web",
    "build:web": "npm run build --workspace=@sankatai/web",
    "lint:web": "npm run lint --workspace=@sankatai/web",
    "dev:mobile": "npm run start --workspace=@sankatai/mobile",
    "android": "npm run android --workspace=@sankatai/mobile",
    "ios": "npm run ios --workspace=@sankatai/mobile",
    "web:preview": "npm run preview --workspace=@sankatai/web",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "patch-package": "^8.0.1"
  },
  "dependencies": {
    "cookie": "^1.1.1",
    "motion-dom": "^13.3.0",
    "ollama": "^0.6.3",
    "set-cookie-parser": "^3.1.2"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "postcss": "^8.5.18",
    "uuid": "^11.1.1"
  }
}
