# Backend environment reference. Deployed config does NOT come from a .env file:
# prod passes these as `docker run -e` in .github/scripts/ec2-rollout.sh (values
# from `terraform output`), and secrets arrive as Docker secrets (<VAR>_FILE).
# Copy to .env only for a bare `python main.py` run. Never put AWS keys here:
# credentials come from the instance role (prod) or your ~/.aws profile (dev).

AWS_REGION=ap-south-1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Local only, without API Gateway in front. Never deploy with false.
AUTH_ENABLED=true

USERS_TABLE=sankatai-user-profile-table
CHAT_HISTORY_TABLE=sankatai-chat-history
ATTACHMENTS_TABLE=sankatai-attachments
CHAT_BUCKET=sankatai-chat-uploads
DOCUMENTS_BUCKET=sankatai-file-storage

# AI provider key: prefer OPENAI_API_KEY_FILE (Docker secret) over the plain var.
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# --- Voice input (Amazon Transcribe Streaming) ---
# The backend only presigns a 60 s wss:// URL; audio goes client -> Transcribe.
# The signing role needs transcribe:StartStreamTranscriptionWebSocket.
# Transcribe identifies the spoken language among these options: >= 2, one
# dialect per language, each supported by streaming LID AND mapped in
# TTS_VOICE_MAP. An invalid value is logged and falls back to en-IN,hi-IN.
VOICE_LANGUAGE_OPTIONS=en-IN,hi-IN
VOICE_PREFERRED_LANGUAGE=en-IN
# Optional custom vocabularies, one per option in the same order.
# VOICE_VOCABULARY_NAMES=sankatai-med-en,sankatai-med-hi
# Clients auto-stop recording after this many seconds.
VOICE_MAX_SECONDS=60
# Per-user session limit (in-process, per backend instance).
VOICE_SESSIONS_PER_MINUTE=10

# The transcript is never sent automatically: it lands in the chat input for review.

# --- Replies + read-aloud (Amazon Comprehend, Amazon Polly) ---
# Typed messages: Comprehend DetectDominantLanguage picks the reply language.
# Read-aloud voice per locale (JSON); unmapped locales fall back to en-IN.
# TTS_VOICE_MAP={"en-IN":{"VoiceId":"Kajal","Engine":"neural","LanguageCode":"en-IN"},"hi-IN":{"VoiceId":"Kajal","Engine":"neural","LanguageCode":"hi-IN"}}
TTS_REQUESTS_PER_MINUTE=20
# Cache synthesized MP3s (7-day lifecycle on tts/) and serve via presigned GET.
TTS_CACHE_ENABLED=false
# Defaults to CHAT_BUCKET (private, SSE-S3, already granted to the role).
# TTS_CACHE_BUCKET=sankatai-chat-uploads

# --- Admin console (/api/admin/*) ---
# Admin routes re-verify the Cognito access token against this pool's JWKS.
# terraform output -raw cognito_user_pool_id / cognito_user_pool_client_id
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
ADMINS_TABLE=sankatai-admins
ADMIN_INVITATIONS_TABLE=sankatai-admin-invitations
ADMIN_AUDIT_TABLE=sankatai-admin-audit-log
# Invites per inviting admin per hour (in-process).
ADMIN_INVITES_PER_HOUR=10
# Invitation emails (SES). Both empty = inviting returns 503.
# APP_URL=https://dxxxxxxxx.cloudfront.net
# SES_SENDER_EMAIL=verified-sender@example.com
# HTTP API id for CloudWatch metrics on System Health (terraform output api_gateway_id).
# API_GATEWAY_ID=abc123

# --- Platform analytics ---
ANALYTICS_ENABLED=true
ANALYTICS_EVENTS_TABLE=sankatai-analytics-events
ANALYTICS_AGG_TABLE=sankatai-analytics-daily-agg
ANALYTICS_EVENT_TTL_DAYS=90
# Day boundaries (minutes east of UTC; 330 = IST).
ANALYTICS_UTC_OFFSET_MINUTES=330
# Pseudonymisation salt: prefer ANALYTICS_SALT_FILE (Docker secret). Without it,
# distinct-user metrics (DAU/WAU/MAU, active now) are not recorded.
# ANALYTICS_SALT_FILE=/run/secrets/analytics_salt
